rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: matches
// Document ID: {matchId} (Firestore auto-generated ID or match UUID)
//
// Fields:
//   - id: string (required, 1-128 chars, matches document ID)
//   - teamA: string (required, 1-100 chars) - Name of Team A
//   - teamB: string (required, 1-100 chars) - Name of Team B
//   - date: string (required, 4-30 chars, format: YYYY-MM-DD)
//   - totalOvers: number (required, integer between 1 and 150)
//   - playersPerTeam: number (optional/nullable, integer between 2 and 50 inclusive, defaults to 11 if omitted)
//   - status: string (required, enum: NOT_STARTED, INNINGS_1, INNINGS_BREAK, INNINGS_2, COMPLETED)
//   - scorerId: string (required, 0-128 chars, Firebase Auth UID of scorer)
//   - currentInningsNumber: number (required, 1 or 2)
//   - innings1: map (required, score, batters list, bowlers list, extras, recentBalls)
//   - innings2: map (optional/nullable, score, batters, bowlers, extras, recentBalls)
//   - target: number (optional/nullable, target score for 2nd innings)
//   - result: string (required, 0-200 chars, e.g. "IGCC won by 4 wickets")
//   - tossWinner: string (required, 0-100 chars)
//   - tossDecision: string (required, 0-20 chars, e.g. "bat" or "bowl")
//   - commonPlayerName: string (optional, 0-100 chars) - Gully cricket common player who plays for both teams
//   - hasCommonPlayer: bool (optional getter serialization) - True if match has a common player configured
//   - createdAt: number (required, timestamp in ms, positive integer, immutable)
//
// Allowed Optional Serialization Helper Getters:
//   - currentInnings: map (optional getter serialization)
//   - isScorable / scorable: bool (optional getter serialization)
//   - maxWickets: number (optional getter serialization, integer between 1 and 49)
//   - hasCommonPlayer: bool (optional getter serialization)
//
// ---------------------------------------------------------------
//
// Collection: active_users
// Document ID: {userId} (Firebase Auth UID, 1-128 chars)
//
// Fields:
//   - uid: string (required, 1-128 chars, matches request.auth.uid and userId)
//   - lastActiveAt: number (required, timestamp in ms, positive integer > 0)
//   - appVersion: string (optional, 0-30 chars) - Client app release version
//   - platform: string (optional, 0-30 chars) - Operating system / platform (e.g. Android)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user (including anonymous auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the assigned scorer or match has no assigned scorer
    function isAuthorizedScorer() {
      return isAuthenticated() && (
        resource.data.scorerId == request.auth.uid ||
        !('scorerId' in resource.data) ||
        resource.data.scorerId == ''
      );
    }

    // Check required top-level match fields exist
    function hasRequiredMatchFields(data) {
      return data.keys().hasAll([
        'id', 'teamA', 'teamB', 'date', 'totalOvers', 'status',
        'scorerId', 'currentInningsNumber', 'innings1',
        'result', 'tossWinner', 'tossDecision', 'createdAt'
      ]);
    }

    // Check only allowed fields are present on the match document
    function hasOnlyAllowedMatchFields(data) {
      return data.keys().hasOnly([
        'id', 'teamA', 'teamB', 'date', 'totalOvers', 'status',
        'scorerId', 'currentInningsNumber', 'innings1', 'innings2',
        'target', 'result', 'tossWinner', 'tossDecision', 'createdAt',
        'currentInnings', 'isScorable', 'scorable',
        'playersPerTeam', 'maxWickets',
        'commonPlayerName', 'hasCommonPlayer'
      ]);
    }

    // Validate innings structure and bounds to prevent resource exhaustion
    function isValidInnings(inningsData) {
      return inningsData is map &&
        inningsData.battingTeam is string && inningsData.battingTeam.size() <= 100 &&
        inningsData.bowlingTeam is string && inningsData.bowlingTeam.size() <= 100 &&
        inningsData.totalRuns is number && inningsData.totalRuns >= 0 &&
        inningsData.wickets is number && inningsData.wickets >= 0 && inningsData.wickets <= 50 &&
        inningsData.oversBowled is number && inningsData.oversBowled >= 0 &&
        inningsData.ballsBowledInOver is number && inningsData.ballsBowledInOver >= 0 && inningsData.ballsBowledInOver <= 5 &&
        inningsData.batters is list && inningsData.batters.size() <= 30 &&
        inningsData.bowlers is list && inningsData.bowlers.size() <= 30 &&
        inningsData.recentBalls is list && inningsData.recentBalls.size() <= 600 &&
        inningsData.extras is map;
    }

    // ===============================================================
    // Domain Validator (Used in both create and update)
    // ===============================================================
    function isValidMatch(data) {
      return hasRequiredMatchFields(data) &&
        hasOnlyAllowedMatchFields(data) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.teamA is string && data.teamA.size() > 0 && data.teamA.size() <= 100 &&
        data.teamB is string && data.teamB.size() > 0 && data.teamB.size() <= 100 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 30 &&
        data.totalOvers is number && data.totalOvers >= 1 && data.totalOvers <= 150 &&
        (!('playersPerTeam' in data) || data.playersPerTeam == null || (data.playersPerTeam is number && data.playersPerTeam >= 2 && data.playersPerTeam <= 50)) &&
        (!('maxWickets' in data) || data.maxWickets == null || (data.maxWickets is number && data.maxWickets >= 1 && data.maxWickets <= 49)) &&
        (!('commonPlayerName' in data) || (data.commonPlayerName is string && data.commonPlayerName.size() <= 100)) &&
        (!('hasCommonPlayer' in data) || data.hasCommonPlayer is bool) &&
        data.status is string && data.status in ['NOT_STARTED', 'INNINGS_1', 'INNINGS_BREAK', 'INNINGS_2', 'COMPLETED'] &&
        data.scorerId is string && data.scorerId.size() <= 128 &&
        data.currentInningsNumber is number && (data.currentInningsNumber == 1 || data.currentInningsNumber == 2) &&
        isValidInnings(data.innings1) &&
        (!('innings2' in data) || data.innings2 == null || isValidInnings(data.innings2)) &&
        (!('target' in data) || data.target == null || (data.target is number && data.target >= 0)) &&
        data.result is string && data.result.size() <= 200 &&
        data.tossWinner is string && data.tossWinner.size() <= 100 &&
        data.tossDecision is string && data.tossDecision.size() <= 20 &&
        data.createdAt is number && data.createdAt > 0;
    }

    // Ensure immutable fields are not tampered with on update
    function areImmutableMatchFieldsUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (resource.data.scorerId == '' || request.resource.data.scorerId == resource.data.scorerId);
    }

    // Check required top-level active_user fields exist
    function hasRequiredActiveUserFields(data) {
      return data.keys().hasAll(['uid', 'lastActiveAt']);
    }

    // Check only allowed fields are present on the active_user document
    function hasOnlyAllowedActiveUserFields(data) {
      return data.keys().hasOnly(['uid', 'lastActiveAt', 'appVersion', 'platform']);
    }

    // Domain Validator for active_users (Used in both create and update)
    function isValidActiveUser(data, userId) {
      return hasRequiredActiveUserFields(data) &&
        hasOnlyAllowedActiveUserFields(data) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.lastActiveAt is number &&
        data.lastActiveAt > 0 &&
        (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 30)) &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 30));
    }

    // ===============================================================
    // Match Collection Rules
    // ===============================================================
    match /matches/{matchId} {
      // 1. Public Read: Anyone can read matches and live scorecards without logging in
      allow read: if true;

      // 2. Authenticated Create: Any authenticated user (including anonymous) can create a match.
      // Must match doc ID and set scorerId to their own UID.
      allow create: if isAuthenticated() &&
        isValidMatch(request.resource.data) &&
        request.resource.data.id == matchId &&
        request.resource.data.scorerId == request.auth.uid;

      // 3. Authorized Update: Only the match scorer can update match and scorecard data.
      // Domain validator and immutability checks are strictly enforced.
      allow update: if isAuthorizedScorer() &&
        isValidMatch(request.resource.data) &&
        areImmutableMatchFieldsUnchanged();

      // 4. Authorized Delete: Only the match creator can delete the match.
      allow delete: if isAuthenticated() && resource.data.scorerId == request.auth.uid;
    }

    // ===============================================================
    // Active Users Collection Rules (Presence & Live Counts)
    // ===============================================================
    match /active_users/{userId} {
      // 1. Public Read: Any app client can observe active user counts
      allow read: if true;

      // 2. Authenticated Create: Authenticated users can register their presence heartbeat
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidActiveUser(request.resource.data, userId);

      // 3. Authenticated Update: Authenticated users can update their heartbeat timestamp
      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidActiveUser(request.resource.data, userId) &&
        (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid);

      // 4. Authenticated Delete: Users can delete their own presence record on sign-out / app exit
      allow delete: if isAuthenticated() &&
        request.auth.uid == userId;
    }

    // Default Deny: Deny all reads and writes to all other document paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
